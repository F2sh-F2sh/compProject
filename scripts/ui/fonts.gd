class_name Fonts
extends RefCounted

## IM Fell English supplies storybook headings and archival pages; Pixelify
## Sans supplies legible pixel dialogue, buttons, signs and HUD labels. Both faces
## are bundled with their SIL Open Font licences. Decorative blackletter
## and tiny all-cap pixel text are deliberately absent from gameplay UI.

const TITLE := preload("res://assets/fonts/im_fell_english/IMFellEnglish-Regular.ttf")
const UI := preload("res://assets/fonts/pixelify_sans/PixelifySans.ttf")
const UI_BOLD := preload("res://assets/fonts/pixelify_sans/PixelifySans.ttf")
const STORY := preload("res://assets/fonts/pixelify_sans/PixelifySans.ttf")
const BOOK := preload("res://assets/fonts/im_fell_english/IMFellEnglish-Regular.ttf")
const BOOK_ITALIC := preload("res://assets/fonts/im_fell_english/IMFellEnglish-Italic.ttf")
const HAND := preload("res://assets/fonts/pixelify_sans/PixelifySans.ttf")
