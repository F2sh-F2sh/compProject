[node name="Chapter1" type="Node2D" unique_id=212766847]
script = ExtResource("1_kq30t")
total_pages = 7
next_chapter = "res://scenes/chapter/chapter_2.tscn"
ledger = Array[Dictionary]([{
"id": "ch1.page.1",
"numeral": "i",
"room": "The Forgotten Entrance",
"text": "The belfry is sealed. The watchers turn to stone in holy light, so we keep the lamps lit and the bells quiet.",
"title": "The Bellkeeper's Ledger, i"
}, {
"id": "ch1.page.2",
"numeral": "ii",
"room": "The Bellkeeper's Cell",
"text": "The slimes of the lower cells come to the bell like hounds. We ring it at feeding time. Some say they think the bell is their mother.",
"title": "The Bellkeeper's Ledger, ii"
}, {
"id": "ch1.page.3",
"numeral": "iii",
"room": "The Split Flame",
"text": "Brother Aldous split the altar flame with his silvered glass, so one fire could keep two doors. He was proud of that. The watchers were not.",
"title": "The Bellkeeper's Ledger, iii"
}, {
"id": "ch1.page.4",
"numeral": "iv",
"room": "The Silent Watcher",
"text": "The watcher on the east stair has not moved in nine years. Nobody has been brave enough to put out its lamp and find out why.",
"title": "The Bellkeeper's Ledger, iv"
}, {
"id": "ch1.page.5",
"numeral": "v",
"room": "Broken Machinery",
"text": "The engineers built the works above the old tunnel so the watchers could not follow them home. The tunnel door only opens from the far side.",
"title": "The Bellkeeper's Ledger, v"
}, {
"id": "ch1.page.6",
"numeral": "vi",
"room": "Lantern Crossing",
"text": "The wisps were lamplighters once. They still go where they are called, and they still do not like to be hurried.",
"title": "The Bellkeeper's Ledger, vi"
}, {
"id": "ch1.page.7",
"numeral": "vii",
"room": "The Sealed Belfry",
"text": "If you are reading this, the seal has answered you. Ring the great bell once for me, stranger. It has been so quiet.",
"title": "The Bellkeeper's Ledger, vii"
}])

