[node name="Cistern" type="Node2D" unique_id=1557657078]
script = ExtResource("1_sq1y2")
chapter_id = "cistern"
chapter_title = "The Drowned Cistern"
unit_name = "wing"
complete_heading = "THE BELL HAS RUNG"
next_label = "Continue"
grants_words = PackedStringArray("ice", "freeze", "long", "persist", "down_right")
total_pages = 6
next_chapter = "res://scenes/story/interlude_cistern.tscn"
ledger = Array[Dictionary]([{
"id": "cistern.page.1",
"numeral": "i",
"room": "The Still Water",
"text": "The Cistern measured the sky by its water: the tide filled the clock, the clock struck, and the Choir wrote down the hour. The night the Hush came every clock in the Cistern stopped at the same minute, and the water stood still.",
"title": "The Warden's Ledger, i"
}, {
"id": "cistern.page.2",
"numeral": "ii",
"room": "The Still Water",
"text": "The fountains were the novices' stair. We froze them every morning, all at once, aslant, and climbed to the clock before they let go. Wren ran up them laughing and never once looked down.",
"title": "The Warden's Ledger, ii"
}, {
"id": "cistern.page.3",
"numeral": "iii",
"room": "The Still Water",
"text": "To stop the clock you need only stop the water. To stop it at the hour, the cold must lie above the mark, no lower: the tide freezes where it first touches the cold. I taught every novice that, and it was still the Hush that did it best.",
"title": "The Warden's Ledger, iii"
}, {
"id": "cistern.page.4",
"numeral": "iv",
"room": "The Great Sluice",
"text": "Ilse came to me the winter before the Hush and asked for the word that holds water still for ever. I carved PERSIST for her on the sluice, the way I carve all the words. I did not ask what she meant to hold still. I have asked every day since.",
"title": "The Warden's Ledger, iv"
}, {
"id": "cistern.page.5",
"numeral": "v",
"room": "The Great Sluice",
"text": "I set the Great Sluice on a weigh pan and gave it two live weights that would never keep still. Then I drowned the Tide Bell in its well, so the Hush would not hear it ring. If you are reading this, hold them still and ring it. Let it hear.",
"title": "The Warden's Ledger, v"
}, {
"id": "cistern.page.6",
"numeral": "vi",
"room": "The Great Sluice",
"text": "The girl drew a star on the far pier at low tide and dared me to freeze the sea so she could reach it. I did. She stood on the ice and laughed and said the water was holding its breath.",
"title": "The Warden's Ledger, vi"
}])

