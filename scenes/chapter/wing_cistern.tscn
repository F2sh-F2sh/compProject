[node name="HintStone" type="Node2D" parent="R2" unique_id=432177522 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(4128, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The plate in the cell opens the gate, but only once it has been held down a long while. A freeze lets go too soon.", "Read the tablet by the door. Persist: cold that never lets go, for as long as its cube is on.", "Inscribe Persist on the cube over the grate and switch it on. Wait: the slime stays frozen, and after a few breaths the gate grinds open for good.")
focus_nodes = [NodePath("../KeeperCube"), NodePath("../Keeper"), NodePath("../CellPlate"), NodePath("../SilenceGate"), NodePath("../TabletPersist")]

[node name="@Node2D@27" type="Node2D" parent="R2" unique_id=95199292 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(4640, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The tide fills the hall and empties it, over and over, and the floor under it is iron teeth. While the water is up, the doorway gates stay shut.", "The Tide Lever over the doorway, worked from this lectern, freezes the tide into a floor of ice: switched on while the hall is dry, the rising tide freezes level with the doorway. But its freeze lets go after six seconds.", "Inscribe Persist on the lever and switch it on while the hall is dry: the tide freezes level with the doorway and holds. Walk across, hop the low pier for the Sluice Cube, and go on.")
focus_nodes = [NodePath("../TideLever"), NodePath("../WestLectern"), NodePath("../Tide"), NodePath("../WestTideGate"), NodePath("../EastTideGate"), NodePath("../SluiceCube")]

[node name="@Node2D@28" type="Node2D" parent="R2" unique_id=299340796 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(6112, 146)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The far pier, with its page, stands too high for ice at the doorways.", "From up here you can watch the tide fall. Switched on while the tide is up, the lever freezes it where it stands.", "Switch the lever on from this lectern as the falling tide passes a little below the pier\'s top, then drop onto the ice and hop up. The lectern on the pier brings you down again: switch it on while the hall is dry.")
focus_nodes = [NodePath("../TideLever"), NodePath("../HighLectern"), NodePath("../Tide")]

[node name="@Node2D@29" type="Node2D" parent="R2" unique_id=1824184128 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(6584, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The Great Sluice\'s pan wants two weights of stone. The two slimes hopping on it are too light alive.", "A frozen creature is as heavy as stone, but it thaws unless the cold persists. The socket at the end of the pan feeds any cube set in it.", "Set the Sluice Cube in the socket and inscribe Ice, Freeze and Persist (it already faces the pan). Switch it on: the slimes freeze as they hop into the cold and stay frozen, the pan sinks, and the Great Sluice opens for good.")
focus_nodes = [NodePath("../WeighPan"), NodePath("../WeighPedestal"), NodePath("../WeigherA"), NodePath("../WeigherB"), NodePath("../GreatSluiceGate")]

[node name="@Node2D@30" type="Node2D" parent="R2" unique_id=1575391959 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
