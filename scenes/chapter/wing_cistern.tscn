[node name="HintStone" type="Node2D" parent="R1" unique_id=1649909348 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(96, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The water is far too cold to swim. The cube at its edge can hold it still.", "Read the tablets: Ice and Freeze. Cold that reaches the water turns its top to ice for a few breaths, solid enough to walk on.", "Inscribe Ice and Freeze on the Brink Cube, switch it on and cross before the ice gives way. On the island, Long carries the cold nearly twice as far: run along the ice and jump the last stretch.")
focus_nodes = [NodePath("../BrinkCube"), NodePath("../IslandCube"), NodePath("../Pool7"), NodePath("../Pool11"), NodePath("../TabletIce"), NodePath("../TabletFreeze"), NodePath("../TabletLong")]

[node name="@Node2D@21" type="Node2D" parent="R1" unique_id=1167414683 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(1200, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("A plug of old ice fills the doorway to the hall.", "Ice holds against cold. It doesn\'t hold against fire.", "Throw a fireball at the ice. The cube behind it is yours to carry.")
focus_nodes = [NodePath("../IcePlug"), NodePath("../WardenCube")]

[node name="@Node2D@22" type="Node2D" parent="R1" unique_id=2079562848 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(2120, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The gate up on the walkway opens while the plate in the cell under this grate is held down by something heavy. The slime shut in with it isn\'t heavy enough.", "What the cold holds still is as heavy as stone. And cold sinks through iron bars.", "Set your cube down on the grate, right over the slime, inscribe Ice, Freeze, Down and switch it on. Two seconds on the plate and the gate stays open.")
focus_nodes = [NodePath("../GatePlate"), NodePath("../Keeper"), NodePath("../ClockGate")]

[node name="@Node2D@23" type="Node2D" parent="R1" unique_id=26476827 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(2928, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The fountains leap and fall. Frozen, a fountain is a pillar you can stand on.", "A jet that leaps into the cold freezes where it first meets it. The cube high above the fountains is worked from the lectern; its cold can only fall from up there. Which way, to touch every fountain at a different height?", "At the lectern: Down-Right and Long. The cold falls aslant across all five and freezes them into a stair up to the walkway. Climb quickly; it holds a few breaths.")
focus_nodes = [NodePath("../FountainCube"), NodePath("../FountainLectern"), NodePath("../TabletDownRight"), NodePath("../Fountain1"), NodePath("../Fountain2"), NodePath("../Fountain3"), NodePath("../Fountain4"), NodePath("../Fountain5")]

[node name="@Node2D@24" type="Node2D" parent="R1" unique_id=808152598 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_gwhw4")]
position = Vector2(1640, 534)
script = ExtResource("47_uapfw")
hints = PackedStringArray("The Sluice Door opens when the tide clock strikes. It strikes only when its float is held still at the hour mark at the top.", "Rising water freezes where it first touches the cold. Cold across the column stops the tide short of the mark; cold just above the mark stops it at the hour.", "Carry the cube up to the clock gallery, the step level with the top of the clock, set it down facing the clock and inscribe Ice, Freeze, Left. The cold lasts a few breaths: switch it on as the tide starts to rise.")
focus_nodes = [NodePath("../TideClock"), NodePath("../SluiceDoor")]

