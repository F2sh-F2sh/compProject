[node name="Galleries" type="Node2D" unique_id=1118845644]
script = ExtResource("1_q718q")
chapter_id = "galleries"
chapter_title = "The Folded Galleries"
unit_name = "wing"
complete_heading = "THE BELL HAS RUNG"
next_label = "Continue"
grants_words = PackedStringArray("space", "portal", "repeat", "down_left")
total_pages = 5
next_chapter = "res://scenes/story/interlude_galleries.tscn"
ledger = Array[Dictionary]([{
"id": "galleries.page.1",
"numeral": "i",
"room": "The Folded Archive",
"text": "I folded the archive the night the bell cracked. Every star the Choir ever wrote down is still here, in rooms you cannot walk to. The Hush listens for doors. It has never learned to listen for distance.",
"title": "The Archivist's Ledger, i"
}, {
"id": "galleries.page.2",
"numeral": "ii",
"room": "The Folded Archive",
"text": "Wren used to sit on the top shelf of the stacks, where no ladder reaches, and read the star-books upside down. She found the way up before I did. She said a door does not care which way is down.",
"title": "The Archivist's Ledger, ii"
}, {
"id": "galleries.page.3",
"numeral": "iii",
"room": "The Folded Archive",
"text": "This hollow is the smallest room in the archive, and the one I am proudest of. Ilse came here to ask me to fold the Eye. I told her a fold is not a lock. You can always find the door if you know how far to walk.",
"title": "The Archivist's Ledger, iii"
}, {
"id": "galleries.page.4",
"numeral": "iv",
"room": "Wren's Test",
"text": "Wren made a game of my locks. She would write half a sentence on a cube and leave it for the novices, and laugh when they stood in front of it for an hour. Finish what I started, she wrote on the wall. Every one of them did.",
"title": "The Archivist's Ledger, iv"
}, {
"id": "galleries.page.5",
"numeral": "v",
"room": "Wren's Test",
"text": "Ilse has not come down from the Eye in a year. I take her bread to the door and it is still there in the morning. Wren comes instead. She is not cold, and she is not warm. She asks me to read her the stars, and she always asks for the one with no name.",
"title": "The Archivist's Ledger, v"
}])

