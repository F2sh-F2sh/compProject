page_id = "galleries.page.4"
title = "The Archivist's Ledger, iv"
text = "Wren made a game of my locks. She would write half a sentence on a cube and leave it for the novices, and laugh when they stood in front of it for an hour. Finish what I started, she wrote on the wall. Every one of them did."

