[node name="HintStone" type="Node2D" parent="R1" unique_id=1649909348 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(120, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("The Archive\'s door is frozen shut, and there is rock behind it. The cube beside it is the Archivist\'s.", "A portal is a doorway by the cube, and another one further on, through stone and shut doors. Walk into one, come out of the other.", "Read both tablets, write Space and Portal on the Door Cube and switch it on. Hop over the cube into its doorway.")
focus_nodes = [NodePath("../DoorCube"), NodePath("../TabletSpace"), NodePath("../TabletPortal")]

[node name="@Node2D@48" type="Node2D" parent="R1" unique_id=1453438795 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(1120, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("The lever is on a shelf far too high to jump to. There is a socket on the floor beneath it.", "A portal Up opens its far side in the air above the cube: over the shelf.", "Write Space, Portal, Up on the Archive Cube, set it in the socket and switch it on. Jump into the doorway over the cube.")
focus_nodes = [NodePath("../ArchiveCube"), NodePath("../LiftSocket"), NodePath("../StacksLever")]

[node name="@Node2D@49" type="Node2D" parent="R1" unique_id=671411656 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(2016, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("The gate is open only while the plate in the sealed pocket overhead is pressed.", "You can\'t stand on the plate and walk through the gate. An Echo follows the path you recorded, even through a door that has gone.", "With the Archive Cube\'s doorway Up under the pocket: record an Echo jumping in and onto the plate. It will stay there. Then walk through the gate.")
focus_nodes = [NodePath("../ReadingSocket"), NodePath("../PocketPlate"), NodePath("../ReadingGate")]

[node name="@Node2D@50" type="Node2D" parent="R1" unique_id=807485451 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(3040, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("Rock from the floor to the roof. The Pillar Cube can open a door through it. The gate past the pillar is held by a plate.", "A plain doorway comes out 224 px on, inside the pillar, by the plate. Long goes all the way through. An Echo goes where you went, even after the cube has changed.", "Write Right and record an Echo hopping into the doorway onto the hollow\'s plate. Come back out, change the cube to Long and go through: the Echo holds the gate open.")
focus_nodes = [NodePath("../PillarCube"), NodePath("../HollowPlate"), NodePath("../PillarGate")]

[node name="@Node2D@51" type="Node2D" parent="R1" unique_id=178606306 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(4064, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("The brazier that opens the Archive Door is shut in a hearth up in the wall.", "Fire flies through a doorway too, and keeps going the way it was thrown.", "At the lectern, write Right on the Hearth Cube and switch it on. Stand under its doorway and throw fire straight up.")
focus_nodes = [NodePath("../HearthCube"), NodePath("../HearthLectern"), NodePath("../HearthBrazier")]

