[node name="HintStone" type="Node2D" parent="R2" unique_id=1717812529 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(4784, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("The way on is up the lift\'s shaft. The lift moves only while the brazier in the chimney over Wren\'s lock burns, and it burns two seconds.", "Repeat: it happens again and again while the cube is on.", "Read the tablet and finish Wren\'s sentence on the Ember Lock with Repeat. Ride the lift up.")
focus_nodes = [NodePath("../EmberLock"), NodePath("../EmberBrazier"), NodePath("../EmberLift"), NodePath("../TabletRepeat")]

[node name="@Node2D@56" type="Node2D" parent="R2" unique_id=1070024287 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(5680, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("Five fountains leap and fall. Wren\'s Frost Lock hangs over them; its lectern is here.", "Frozen, a fountain is a pillar. Cold laid aslant meets each jet at a different height.", "At the lectern, finish the Frost Lock with Down-Left and switch it on, then climb the frozen jets to the walkway. Quickly: it holds a few breaths.")
focus_nodes = [NodePath("../FrostLock"), NodePath("../FrostLectern"), NodePath("../TabletDownLeft"), NodePath("../Fountain1"), NodePath("../Fountain2"), NodePath("../Fountain3"), NodePath("../Fountain4"), NodePath("../Fountain5")]

[node name="@Node2D@57" type="Node2D" parent="R2" unique_id=1305693287 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(6752, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("Two hearths, each with a doorway under it. The seal wants both fires burning at once.", "Each burns two seconds, and they are too far apart to light one and run to the other. An Echo throws the fire you threw.", "Record an Echo throwing fire up through one doorway (wait a little first). Then go to the other and throw when your Echo does.")
focus_nodes = [NodePath("../WestHearthCube"), NodePath("../EastHearthCube"), NodePath("../WestHearth"), NodePath("../EastHearth")]

[node name="@Node2D@58" type="Node2D" parent="R2" unique_id=1758254797 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("36_relj4")]
position = Vector2(7808, 534)
script = ExtResource("37_5hmrw")
hints = PackedStringArray("Wren\'s Lens Lock, three mirrors and a crystal. The last mirror\'s wheel is shut in the pocket over it.", "A plain beam stops at the first mirror. The Pocket Cube\'s doorway goes up into the pocket.", "Write Bounce on the Lens Lock. Turn the low mirror to send the beam up, the high one to send it right; go up through the Pocket Cube\'s doorway and turn the last to send it down.")
focus_nodes = [NodePath("../LensLock"), NodePath("../LensMirrorLow"), NodePath("../LensMirrorHigh"), NodePath("../LensMirrorFar"), NodePath("../PocketCube"), NodePath("../LastCrystal")]

