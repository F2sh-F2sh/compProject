[node name="LorePage5" type="Area2D" parent="R2" unique_id=1049391205 instance=ExtResource("20_6ynmr")]
position = Vector2(7968, 300)
script = ExtResource("21_8mata")
page_id = "galleries.page.5"
title = "The Archivist's Ledger, v"
text = "Ilse has not come down from the Eye in a year. I take her bread to the door and it is still there in the morning. Wren comes instead. She is not cold, and she is not warm. She asks me to read her the stars, and she always asks for the one with no name."

[node name="Wren" type="Node2D" parent="R2" unique_id=1784441520]
position = Vector2(8352, 534)
script = ExtResource("50_in7u2")
lines = PackedStringArray("wren/calm: You came all this way. Mum said nobody would.", "echidna/surprised: The chalk stars. It was you, all along.", "wren/smile: I left them so you wouldn\'t get lost. The Galleries fold if you let them.", "wren/pleading: Mum won\'t let go. Please.", "echidna/worried: Let go of what?", "wren/calm: Me. She holds the moment so I can\'t leave it. It has been sixty years, and it is still the same night.", "wren/pleading: I want it to end. I just don\'t want Mum to be alone.", "wren/calm: Ring the bell. Then come to the Eye. I\'ll be there.")

