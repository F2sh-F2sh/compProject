hints = PackedStringArray("The Gallery Lamp\'s crystal is past the mirrors. A plain beam stops at the first mirror it meets.", "Bounce: light that turns at every mirror. A mirror turns light off its bright face only; each one turns from the wheel on the floor below it.", "Switch the Gallery Cube off, inscribe Bounce and switch it on. Turn the first mirror to send the beam up, the high one to send it right, and the far one to send it down onto the crystal.")
focus_nodes = [NodePath("../GalleryCube"), NodePath("../MirrorLow"), NodePath("../MirrorHigh"), NodePath("../MirrorFar"), NodePath("../GalleryCrystal"), NodePath("../TabletBounce")]

[node name="@Node2D@37" type="Node2D" parent="R1" unique_id=1117842088 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_q4wn4")]
position = Vector2(2480, 534)
script = ExtResource("47_ku2hj")
hints = PackedStringArray("The Watchers were monks of the Choir. Light doesn\'t hurt them: it holds them still, as heavy as stone.", "A glow lights a circle round its cube. Glow can only shine on all sides: Self. A Watcher stops where the light begins.", "Write Light, Glow and Self on the Watch Cube, set it in the socket on the plate and switch it on. The Watcher stops on the plate as stone. (Large stops it before the plate.)")
focus_nodes = [NodePath("../WatchCube"), NodePath("../WatcherA"), NodePath("../MonkPlate"), NodePath("../PlateSocket"), NodePath("../TabletGlow"), NodePath("../TabletSelf")]

[node name="@Node2D@38" type="Node2D" parent="R1" unique_id=2112481754 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("46_q4wn4")]
position = Vector2(3296, 534)
script = ExtResource("47_ku2hj")
hints = PackedStringArray("The Watch Lamp\'s crystal is up on the ledge, too high to jump to from the floor.", "The brazier over the pacing Watcher is dark. Fire lights it, and its light would hold him still: something to stand on.", "Throw fire at the brazier. Carry the Watch Cube onto the Watcher\'s back, make a charged jump to the ledge, set the cube in the socket and make it glow.")
focus_nodes = [NodePath("../WatcherB"), NodePath("../MonkBrazier"), NodePath("../LampSocket"), NodePath("../WatchCrystal")]

