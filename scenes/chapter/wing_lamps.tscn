[node name="Lamps" type="Node2D" unique_id=541401934]
script = ExtResource("1_3kyfl")
chapter_id = "lamps"
chapter_title = "The Lampworks"
unit_name = "wing"
complete_heading = "THE BELL HAS RUNG"
next_label = "Continue"
grants_words = PackedStringArray("light", "beam", "glow", "self", "bounce", "up_left")
total_pages = 3
next_chapter = "res://scenes/story/interlude_lamps.tscn"
ledger = Array[Dictionary]([{
"id": "lamps.page.1",
"numeral": "i",
"room": "The Hall of Lamps",
"text": "Every star the Choir ever named was written down in this hall, under these lamps. I kept them burning forty years. A reader should never have to stop because the light went out.",
"title": "The Lamplighter's Ledger, i"
}, {
"id": "lamps.page.2",
"numeral": "ii",
"room": "The Hall of Lamps",
"text": "Ilse asked me to put out the lamps of the east halls the night she went down to the Eye. I did not ask her why. The dark is where the Watchers walk now, and I have stopped going east.",
"title": "The Lamplighter's Ledger, ii"
}, {
"id": "lamps.page.3",
"numeral": "iii",
"room": "The Hall of Lamps",
"text": "The Watchers are not stone. They are us. Light does not hurt them: it holds them still, the way we used to hold still to hear the bell. If you find Brother Aldous walking in the dark, tell him I kept his lamp.",
"title": "The Lamplighter's Ledger, iii"
}])

