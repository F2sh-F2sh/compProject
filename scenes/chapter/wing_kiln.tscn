[node name="HintStone" type="Node2D" parent="R1" unique_id=1062255740 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_guutb")]
position = Vector2(104, 534)
script = ExtResource("51_ysclv")
hints = PackedStringArray("The brazier across the slag is too far for your own fire. The cube at the edge throws further.", "Dry brambles stand in front of the brazier. A bolt stops at the first thing it hits, and burns brambles away.", "Read both tablets, inscribe Fire and Projectile on the Forge Cube and switch it on: once for the brambles, once more for the brazier.")
focus_nodes = [NodePath("../ForgeCube"), NodePath("../Brambles"), NodePath("../PilotFlame"), NodePath("../TabletFire"), NodePath("../TabletProjectile")]

[node name="@Node2D@10" type="Node2D" parent="R1" unique_id=1388324655 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_guutb")]
position = Vector2(1010, 534)
script = ExtResource("51_ysclv")
hints = PackedStringArray("Air rises out of the bellows shaft, and a brazier hangs dark above it. The groove from it runs all the way to the slag beyond the kiln.", "Air carries flame: fire that flies into a current turns and goes with it. The shaft carries you, too.", "Throw a fireball into the shaft: it rises and lights the hanging brazier, which raises the bridge over the slag past the kiln. Ride the shaft up to reach the gallery and the kiln\'s roof.")
focus_nodes = [NodePath("../BellowsShaft"), NodePath("../HoistBrazier"), NodePath("../SlagBridge1")]

[node name="@Node2D@11" type="Node2D" parent="R1" unique_id=808447147 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_guutb")]
position = Vector2(1196, 274)
script = ExtResource("51_ysclv")
hints = PackedStringArray("The Explode tablet is sealed behind a plug of cold slag. The stone in front of it is pressed right up against the plug.", "A steady wind only leans on the stone: it has no room to gather speed. A single gust strikes all at once. The Bench Cube\'s first two words are carved: Wind, Push.", "Carry the cube from the coal loft (its words are all free) up the shaft to this landing. Set it down here, inscribe Wind, Burst, Left, Strong and switch it on: the gust crosses the gap and strikes the stone.")
focus_nodes = [NodePath("../SlagCrust"), NodePath("../BenchStone"), NodePath("../BenchCube"), NodePath("../TabletExplode")]

[node name="@Node2D@12" type="Node2D" parent="R1" unique_id=180605343 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_guutb")]
position = Vector2(1966, 274)
script = ExtResource("51_ysclv")
hints = PackedStringArray("The kiln burns coal, and the coal cart is up here. Below the loft\'s west edge is slag.", "Anything that falls into the slag burns. The bridge over it rises only when the brazier above the bellows shaft is lit.", "Light the hanging brazier first (fire up the shaft). Then push the cart west off the loft with Wind, Push, Left so it lands on the bridge, carry the cube down and push the cart into the kiln\'s fuel bay.")
focus_nodes = [NodePath("../CoalCart"), NodePath("../LoftCube"), NodePath("../SlagBridge1")]

[node name="@Node2D@13" type="Node2D" parent="R1" unique_id=934022937 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_guutb")]
position = Vector2(904, 534)
script = ExtResource("51_ysclv")
hints = PackedStringArray("Three lamps on the kiln: coal, air, fire. A grate guards its mouth; the only way in is the pipe on its left side.", "The pipe needs a current blowing into it at its own height: only the perch with the pedestal is that high. And a spark only hisses on the cold coal: it wants a flame that bursts.", "Put the Bench Cube on the perch\'s pedestal: Wind, Push, Right. Put the loft\'s cube on the floor below, between the perch and the shaft: Fire, Projectile, Right, Explode. Its bolt rides the shaft up, turns into the perch\'s current and flies into the pipe.")
focus_nodes = [NodePath("../GreatKiln"), NodePath("../PerchPedestal"), NodePath("../BellowsShaft")]

