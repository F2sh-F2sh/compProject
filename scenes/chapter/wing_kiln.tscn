[node name="HintStone" type="Node2D" parent="R2" unique_id=444410700 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_gf5do")]
position = Vector2(3040, 534)
script = ExtResource("51_8mliy")
hints = PackedStringArray("The lamp beyond the shutter is out of reach of your own fire. The cube by the shutter throws further.", "The shutter stays up only while someone stands on the plate, and you can\'t be at the cube and on the plate at once.", "Read the Delay tablet. Inscribe Delay on the cube and switch it on, then run back onto the plate: two seconds later its bolt flies through the open shutter and lights the lamp.")
focus_nodes = [NodePath("../ShutterCube"), NodePath("../ShutterPlate"), NodePath("../Shutter"), NodePath("../AshLamp"), NodePath("../TabletDelay")]

[node name="@Node2D@14" type="Node2D" parent="R2" unique_id=1504054621 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_gf5do")]
position = Vector2(3480, 534)
script = ExtResource("51_8mliy")
hints = PackedStringArray("Three columns of heat rise out of the slag.", "Ride a column to its top and step off onto the ledge beside it. If you fall, the slag throws you back to the last candle you touched.", "Walk off the bank into the first column, rise, and step right onto the ledge. Hop the break in it (or drop through onto the low ledge) and walk off the far end into the next column. The third lets you off on the gallery.")
focus_nodes = [NodePath("../Vent1"), NodePath("../Vent2"), NodePath("../Vent3")]

[node name="@Node2D@15" type="Node2D" parent="R2" unique_id=219988792 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_gf5do")]
position = Vector2(5216, 274)
script = ExtResource("51_8mliy")
hints = PackedStringArray("Three skips of coal sit on three iron racks over the Heart. It needs all three.", "A gust from the pedestal at the end of the gallery strikes only what is level with it. The racks are iron bars: wind blows straight through them.", "Set the gallery\'s cube in the pedestal and inscribe Wind, Burst, Right, Large: one wide gust tips all three skips into the Heart.")
focus_nodes = [NodePath("../RackCube"), NodePath("../RackPedestal"), NodePath("../TabletLarge"), NodePath("../Skip1"), NodePath("../Skip2"), NodePath("../Skip3")]

[node name="@Node2D@16" type="Node2D" parent="R2" unique_id=958443266 node_paths=PackedStringArray("focus_nodes") instance=ExtResource("50_gf5do")]
