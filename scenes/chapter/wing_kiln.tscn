[node name="Kiln" type="Node2D" unique_id=353244508]
script = ExtResource("1_v6r5j")
chapter_id = "kiln"
chapter_title = "The Kilnworks"
unit_name = "wing"
complete_heading = "THE BELL HAS RUNG"
next_label = "Continue"
grants_words = PackedStringArray("fire", "projectile", "split", "up", "large", "burst", "delay", "explode")
total_pages = 6
next_chapter = "res://scenes/story/interlude_kiln.tscn"
ledger = Array[Dictionary]([{
"id": "kiln.page.1",
"numeral": "i",
"room": "The Cold Forge",
"text": "The Hush came down the flues before it came through the doors. We let the Great Kiln go cold so the frost would have nothing to hold on to. Whoever wakes it: fire, coal and air, all three at once, or it will not draw.",
"title": "The Smith's Ledger, i"
}, {
"id": "kiln.page.2",
"numeral": "ii",
"room": "The Cold Forge",
"text": "Air carries flame. My bellows could send a spark up the shaft and into the kiln's pipe without anyone going near it. The coal is damp with frost now; a spark will only hiss on it. It wants a flame that bursts.",
"title": "The Smith's Ledger, ii"
}, {
"id": "kiln.page.3",
"numeral": "iii",
"room": "The Cold Forge",
"text": "The Prior's girl came through the hall again. She drew a star on my anvil in chalk and asked why fire is afraid of the cold. I told her it isn't. It is the cold that runs from the fire. She liked that.",
"title": "The Smith's Ledger, iii"
}, {
"id": "kiln.page.4",
"numeral": "iv",
"room": "The Kiln Heart",
"text": "The Kiln Heart takes the Great Kiln's heat up the tower and wakes the Forge Bell with it. Three skips of coal and three burners lit together, or it lies cold. When the Hush came I let it go cold, and the bell froze in its tower.",
"title": "The Smith's Ledger, iv"
}, {
"id": "kiln.page.5",
"numeral": "v",
"room": "The Kiln Heart",
"text": "My apprentice crossed the lake on the heat. Up the column, off at the top, never look down. He fell twice and the slag spat him back both times. He did not fall a third time.",
"title": "The Smith's Ledger, v"
}, {
"id": "kiln.page.6",
"numeral": "vi",
"room": "The Kiln Heart",
"text": "The girl asked to ring the Forge Bell. I let her, once. She laughed at the noise and drew a star on the hoist. If someone finds this: the bell is still yours to ring. Make it loud.",
"title": "The Smith's Ledger, vi"
}])

