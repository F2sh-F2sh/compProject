[sub_resource type="Shader" id="Shader_dim"]
code = "shader_type canvas_item;

// Dims, desaturates and vignettes whatever is behind this rect.
uniform sampler2D screen_tex : hint_screen_texture, filter_linear_mipmap;
uniform float amount : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec3 c = texture(screen_tex, SCREEN_UV).rgb;
	float grey = dot(c, vec3(0.299, 0.587, 0.114));
	c = mix(c, vec3(grey), 0.65 * amount);
	c *= mix(1.0, 0.42, amount);
	vec2 d = (UV - 0.5) * vec2(1.0, 1.25);
	float vignette = smoothstep(0.3, 0.85, length(d));
	c *= 1.0 - vignette * 0.55 * amount;
	COLOR = vec4(c, 1.0);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_dim"]
shader = SubResource("Shader_dim")
shader_parameter/amount = 0.0

[sub_resource type="Shader" id="Shader_band"]
code = "shader_type canvas_item;

// A horizontal black band whose top and bottom fade out softly.
uniform float opacity : hint_range(0.0, 1.0) = 0.94;
uniform float solid_core : hint_range(0.0, 1.0) = 0.5;

void fragment() {
	float y = abs(UV.y - 0.5) * 2.0;
	float a = 1.0 - smoothstep(solid_core, 1.0, y);
	float x = abs(UV.x - 0.5) * 2.0;
	a *= 1.0 - smoothstep(0.8, 1.0, x) * 0.3;
	COLOR = vec4(0.0, 0.0, 0.0, a * opacity);
}
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_band"]
shader = SubResource("Shader_band")
shader_parameter/opacity = 0.94
shader_parameter/solid_core = 0.5

